# === Runtime configuration ===
APP_ENV=dev
HOST=0.0.0.0
PORT=8000

# === API security (recommended for office devices) ===
# Require callers to provide:  X-API-Key: <API_AUTH_KEY>
API_AUTH_ENABLED=1
API_AUTH_KEY=replace_me_with_a_long_random_value
# Comma-separated allowed browser origins for CORS
CORS_ALLOW_ORIGINS=http://localhost:3000

# === Database (Docker compose uses these) ===
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=reco
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://app:app@db:5432/reco

# === Elasticsearch ===
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_ITEMS_INDEX=items
# Optional: ELASTICSEARCH_USERNAME=
# Optional: ELASTICSEARCH_PASSWORD=
# Optional: ELASTICSEARCH_VERIFY_CERTS=0
# Optional: ELASTICSEARCH_TIMEOUT=15
# Optional: ELASTICSEARCH_KNN_K=40
# Optional: ELASTICSEARCH_KNN_NUM_CANDIDATES=200
# Opt in to direct structured filtering and omit the SQL ANN allowlist; set to 0 to roll back.
# Hybrid lexical/vector results are always fused by the client with weighted RRF.
RETRIEVAL_CONSOLIDATED_FILTERS=0

# === Retrieval backend ===
# ANN_BACKEND can be 'elasticsearch' (default) or 'pgvector'
ANN_BACKEND=elasticsearch

# === External APIs (placeholders) ===
TMDB_API_KEY=replace_me
TMDB_PAGE_LIMIT=20
JUSTWATCH_COUNTRY=IL
JUSTWATCH_LANGUAGE=en
JUSTWATCH_PLATFORM=WEB
USER_PROFILE_DECAY_HALF_LIFE=10

# === Local Cross-Encoder reranker ===
# The request path uses deterministic explanations and local reranking only.
# An API override may select 'small' for local experiments; remote LLM providers
# are not supported on the synchronous recommendation path.
RERANK_PROVIDER=cross_encoder
RERANK_ENABLED=1
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CROSS_ENCODER_BACKEND=openvino
CROSS_ENCODER_DEVICE=GPU
# Optional (small reranker only):
# SMALL_RERANK_INPUT_WINDOW=40
# SMALL_RERANK_OUTPUT_LIMIT=12
# SMALL_RERANK_TIMEOUT=1.5
# SMALL_RERANK_CACHE_TTL=120
# SMALL_RERANK_CACHE_MAXSIZE=256
# SMALL_RERANK_RANK_WEIGHT=0.05
# Optional: tighten heuristic filtering of low-signal titles (default 0 = disabled)
# HEURISTIC_MIN_SIGNAL_MULTIPLIER=0.7
# Dense and lexical retrieval use the same selected query text.
# 'raw' is the production default; 'strategy_f' is an experimental alternative.
RETRIEVAL_QUERY_FORMULATION=raw

# === Intent Parser (Local Fast Parser - production default) ===
# The synchronous request path always uses deterministic rules plus adaptive GLiNER.
# - DeterministicRuleParser handles known filters; unresolved tokens use GLiNER v2.1.
#   Uncached parse_intent p95 = 27.3 ms (N=220); no parser sample exceeded 200 ms.
#   This is a parser-only measurement, not a whole /recommend API latency claim.
INTENT_PROVIDER=hybrid_fast
# Optional: INTENT_SCOPE_GENRES_BY_MEDIA=1   # scope catalog genres to detected media types (default 1)
# Optional: INTENT_CACHE_PERSIST=1           # persist parsed filters between runs (default 1)
# Optional: INTENT_CACHE_PATH=.cache/intent_cache.sqlite

# === Fast Intent Parser (hybrid_fast runtime configuration) ===
# GLiNER model for zero-shot NER in the fast intent parser.
FAST_INTENT_MODEL=urchade/gliner_small-v2.1
FAST_INTENT_MODEL_REVISION=4e091416cf7c3481db542c2a3d26156916f3a47f
# Production runtime: OpenVINO CPU; unresolved-token queries use this model only.
FAST_INTENT_RUNTIME=openvino
# OpenVINO device: 'CPU' (recommended — bounded tail latency).
# 'GPU' (Intel Arc 140V) has faster median but 747ms tail latency spikes.
# 'NPU' is unsupported: GLiNER's dynamic span shapes cannot be compiled for the systolic NPU.
FAST_INTENT_OPENVINO_DEVICE=CPU
# Path where the exported OpenVINO IR model is stored (model.xml + model.bin).
FAST_INTENT_OPENVINO_DIR=models/gliner_small_ov
# Adaptive gating: bypass GLiNER when all query tokens are explained by deterministic rules.
# Eliminates neural cost entirely for constraint-only queries (~0.13ms, zero observed quality loss).
FAST_INTENT_ADAPTIVE_GATING=1
# GLiNER entity confidence threshold (0.0–1.0). Lower = more recall, higher = more precision.
FAST_INTENT_THRESHOLD=0.35

# === Embedding pipeline (Heterogeneous compute: GPU real-time, NPU background) ===
EMBED_MODEL=all-MiniLM-L6-v2
EMBED_BATCH=64
EMBED_VERSION=v1
EMBED_TEMPLATE=basic
# OpenVINO inference in the Docker API. WSL2 GPU access uses the WSL Compose overlay.
EMBEDDING_BACKEND=openvino
EMBEDDING_DEVICE=GPU
# Native Windows bulk ETL can use the NPU; WSL2 Docker does not expose /dev/accel.
# ETL_EMBEDDING_DEVICE=NPU
# BACKGROUND_TASK_DEVICE=NPU
# The WSL GPU overlay defaults container background work to GPU. Override only
# when the selected WSL device is visible to OpenVINO.
# WSL_ETL_EMBEDDING_DEVICE=GPU
# WSL_BACKGROUND_TASK_DEVICE=GPU

# === Recommendation mixer weights ===
# Optional knobs for blending ANN / collaborative / trending sources
# MIXER_COLLAB_WEIGHT=0.3
# MIXER_TRENDING_WEIGHT=0.2
# MIXER_NOVELTY_WEIGHT=0.1
